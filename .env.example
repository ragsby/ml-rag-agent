# ---- LLM: "groq" or "bedrock" ----
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# ---- AWS Bedrock (set LLM_PROVIDER=bedrock) ----
# Easiest: a Bedrock API key (Bedrock console -> API keys). Leave the AWS_ACCESS_* lines empty.
AWS_BEARER_TOKEN_BEDROCK=
# Or classic IAM access keys (or an AWS CLI profile instead of both):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Must be an inference-profile ID. List yours: aws bedrock list-inference-profiles --region us-east-1
# Claude/GPT models are sold via AWS Marketplace and can fail with INVALID_PAYMENT_INSTRUMENT on some
# accounts (e.g. AWS India with UPI). AWS's own Nova models are billed directly by AWS -- tested working:
#   us.amazon.nova-2-lite-v1:0   us.amazon.nova-pro-v1:0
BEDROCK_MODEL_ID=global.anthropic.claude-opus-5-5

# ---- Qdrant: leave empty to use a local folder (data/qdrant_storage) ----
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=ml_documents

# ---- SQL: default is SQLite in data/database. Postgres example: ----
# DATABASE_URL=postgresql+psycopg://ml:ml@localhost:5432/ml_metrics

# ---- Models ----
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---- Semantic cache ----
ENABLE_SEMANTIC_CACHE=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.88

# ---- LangSmith tracing (optional) ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ML_RAG_AI_AGENT
# Use a Personal Access Token: "tracing" keys can send traces but can not create datasets / experiments.
# Outside the US, also set your region, e.g. https://apac.api.smith.langchain.com or https://eu.api.smith.langchain.com
# LANGSMITH_ENDPOINT=

# ---- Hugging Face MCP (Research mode). Optional: a free "Read" token from
# huggingface.co/settings/tokens raises rate limits. Works without one too.
HF_TOKEN=

# ---- Admin endpoints (/admin/...): if set, send it as the X-Admin-Key header ----
ADMIN_API_KEY=
